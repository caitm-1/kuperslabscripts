    % Resize image to faceSize x faceSize px
    faceImage = imresize(faceImage, [faceSize faceSize]);

    % Store the complete face and its four equal-sized fragments
    completeFaces{i} = faceImage;
    faceFragments{i,1} = faceImage(1:halfFace,          1:halfFace,          :);  % TL
    faceFragments{i,2} = faceImage(1:halfFace,          halfFace+1:faceSize, :);  % TR
    faceFragments{i,3} = faceImage(halfFace+1:faceSize, 1:halfFace,          :);  % BL
    faceFragments{i,4} = faceImage(halfFace+1:faceSize, halfFace+1:faceSize, :);  % BR
